    {
      "storyKey": "figure:5",
      "storyTitle": "Figure: Hatshepsut",
      "slideIndex": 2,
      "contentSummary": "Text:This marker image highlights Hatshepsut's royal form and authority. She launched a famous trading expedition to the Land of Punt, returning with gold, ivory, myrrh trees, and exotic animals, then commemorated this voyage in reliefs at Deir el-Bahari.",
      "startedOffsetMs": 44843,
      "endedOffsetMs": 53845,
      "samples": []
    },
    {
      "storyKey": "figure:5",
      "storyTitle": "Figure: Hatshepsut",
      "slideIndex": 3,
      "contentSummary": "Text:Hatshepsut often had herself depicted as male in statues and inscriptions — wearing a false beard and male regalia — to legitimise her rule in a culture that expected a male pharaoh. After her death, her successor Thutmose III had her images systematically erased.",
      "startedOffsetMs": 53845,
      "endedOffsetMs": 63864,
      "samples": []
    }
  ]
