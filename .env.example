# Copy to .env in repo root (keep skip_* in sync with this file unless you intend dev overrides).
# Python virtual environment folder used by the startup scripts.
venv_name=".museumVenv"

# Set to 1 to skip Face ID auth in the C# app; keep 0 for normal auth.
skip_auth=0

# User id from C#/content/auth/users.csv when skip_auth=1 (e.g. user0).
skip_user=user0
